# Neon PostgreSQL (Dashboard → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob (opcional; sin esto las imágenes se guardan en public/uploads)
BLOB_READ_WRITE_TOKEN=

# Seed del admin (scripts/seed-admin.ts)
ADMIN_EMAIL=profile.curriculum@gmail.com
ADMIN_PASSWORD=
